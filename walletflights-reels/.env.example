# Copy to .env (never commit .env).
# Required for b-roll: https://www.pexels.com/api/ (free key)
PEXELS_API_KEY=
# Optional: premium voice instead of local Kokoro (paid tier needed for commercial use)
ELEVENLABS_API_KEY=
# Optional: Instagram Graph API. Not used; we do NOT post from this pipeline.
IG_ACCESS_TOKEN=
