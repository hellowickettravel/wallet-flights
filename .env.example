# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# Email delivery for the contact form and fare alerts (https://resend.com)
RESEND_API_KEY=
# A sender on a domain you've verified in Resend
EMAIL_FROM="Wallet Flights <hello@walletflights.com>"
# Where contact-form messages go (defaults to info@walletflights.com)
CONTACT_TO=info@walletflights.com
# Optional: Resend audience to store fare-alert subscribers
RESEND_AUDIENCE_ID=

# Route price alerts on the fare calendar (src/lib/price-alerts.ts). The box
# only appears when all three exist: email above, a database and a cron secret.
# Database: Vercel → Storage → Upstash for Redis (free tier) sets these two.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Any long random string; Vercel sends it to the daily check in vercel.json.
CRON_SECRET=
# Optional: signs confirmation and stop links (defaults to the Resend key).
FARE_ALERT_SECRET=

# Travelpayouts Data API token (dashboard → Profile → API token). Server-only:
# used to show real cached fares on deals, destination and route pages. Leave
# empty and prices are simply hidden.
TRAVELPAYOUTS_TOKEN=
# Optional: "true" brings back the demo results UI on /flights instead of the
# Travelpayouts White Label (build-time flag).
NEXT_PUBLIC_DEMO_RESULTS=
